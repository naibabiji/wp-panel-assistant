doctype html
html.tabby
    head
        meta(charset='UTF-8')
        base(href='index.html')
        script.
            console.timeStamp('index')
            window.nodeRequire = require
        script(src='./preload.js')
        script(src='./bundle.js', defer)
        style.
            body { transition: 0.5s background; }
    body
        style#custom-css
        root
        app-root
            .preload-logo
                div
                    .tabby-logo
                    h1.tabby-title WP Panel Assistant
                    .progress
                        .bar(style='width: 0%')
        //- WPPA: product name in the system language (the UI language setting is not loaded yet)
        script.
            if ((navigator.language || '').toLowerCase().startsWith('zh')) {
                document.querySelector('.preload-logo .tabby-title').textContent = 'WP Panel助手'
            }
